   "source": [
    "import numpy as np\n",
    "\n",
    "H = np.array([[2,3,4,7],\n",
    "            [0,2,4,0],\n",
    "            [1,4,5,6],\n",
    "            [4,5,6,7]])\n",
    "\n",
    "H = np.array([[1,2],[3,4]])\n",
    "\n",
    "print(H)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "bf1b34fa",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[0.18257419 0.36514837]\n",
      " [0.54772256 0.73029674]]\n"
     ]
    }
   ],
   "source": [
    "H_norm = H / np.linalg.norm(H)\n",
    "print(H_norm)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "8e33ea84",
   "metadata": {},
   "outputs": [],
   "source": [
